{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".github/copilot-instructions.md",
    ".github/instructions/*.instructions.md"
  ],
  "lsp": true,
  "permission": {
    "bash": {
      "*": "ask",
      "./gradlew *": "allow",
      "ag *": "allow",
      "awk *": "allow",
      "cat *": "allow",
      "cd *": "allow",
      "chmod *": "deny",
      "chown *": "deny",
      "cut *": "allow",
      "date": "allow",
      "dd *": "deny",
      "diff": "allow",
      "echo *": "allow",
      "egrep *": "allow",
      "fgrep *": "allow",
      "file *": "allow",
      "find *": "allow",
      "git branch": "allow",
      "git push": "deny",
      "git commit": "ask",
      "git branch *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git remote *": "allow",
      "git show *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "gh pr view *": "allow",
      "go build *": "allow",
      "go doc *": "allow",
      "go test *": "allow",
      "go version": "allow",
      "go vet *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "jq *": "allow",
      "kill *": "deny",
      "kubectl describe *": "allow",
      "kubectl get *": "allow",
      "kubectl logs *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "pkill *": "deny",
      "printf *": "allow",
      "pwd": "allow",
      "rg *": "allow",
      "rm *": "ask",
      "rmdir *": "ask",
      "scp *": "deny",
      "sed *": "allow",
      "sort *": "allow",
      "ssh *": "deny",
      "stat *": "allow",
      "su *": "deny",
      "sudo *": "deny",
      "tail *": "allow",
      "tr *": "allow",
      "type *": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "yq *": "allow"
    },
    "codesearch": "allow",
    "doom_loop": "ask",
    "edit": "allow",
    "external_directory": {
      "*": "deny",
      "/tmp/**": "allow",
      "{env:HOME}/**": "ask"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "question": "allow",
    "read": {
      "*": "allow",
      "*.env": "ask"
    },
    "skill": "ask",
    "todowrite": "allow",
    "webfetch": "allow"
  },
  "share": "disabled",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**"
    ]
  }
}
